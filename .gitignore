# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
data/jwt-secret.txt
server/data/

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.bak

# ── User-generated data (images, voices, uploaded files) ─────────────────────
# Note: data/comfy-workflows/ is intentionally tracked (project config files)
data/images/
data/tts/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store
._*

# ── TTS service Python venv ───────────────────────────────────────────────────
tts-service/venv/

# ── Backup / temp restore ─────────────────────────────────────────────────────
.restore-tmp/
data/comfy-workflows/*.json2
data/*.db.bak-*

# ── bzHarness (agente local) ──────────────────────────────────────────────────
.bzharness/

# ── Claude Code local files ───────────────────────────────────────────────────
# /memory/ (barra inicial) solo ignora el directorio memory/ en la raíz del
# proyecto, sin afectar a server/src/core/memory/ ni a ningún subdirectorio.
.claude/settings.local.json
/memory/
