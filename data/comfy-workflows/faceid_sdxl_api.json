{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "Juggernaut-XL_v9.safetensors"
    },
    "_meta": { "title": "Juggernaut XL v9" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "a fantasy scene"
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "ugly, deformed, noisy, blurry, low quality, watermark, text, signature, extra limbs, bad anatomy, monochrome, grayscale, black and white, desaturated, pencil sketch, charcoal drawing"
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    },
    "_meta": { "title": "Character Reference Image" }
  },
  "5": {
    "class_type": "easy ipadapterApply",
    "inputs": {
      "model": ["1", 0],
      "image": ["4", 0],
      "preset": "FACEID PORTRAIT UNNORM - SDXL only (strong)",
      "lora_strength": 0.0,
      "provider": "CUDA",
      "weight": 0.55,
      "weight_faceidv2": 0.75,
      "start_at": 0.0,
      "end_at": 0.75,
      "cache_mode": "all",
      "use_tiled": false
    },
    "_meta": { "title": "Apply FaceID" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": { "title": "Latent Image" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler" }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "rpgspeak-faceid",
      "images": ["9", 0]
    },
    "_meta": { "title": "Save Image" }
  }
}
