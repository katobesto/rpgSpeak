{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "dreamshaperXL_lightningDPMSDE.safetensors"
    },
    "_meta": { "title": "Load SDXL Checkpoint" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "a fantasy scene"
    },
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "ugly, deformed, noisy, blurry, low quality, watermark, text, signature, extra limbs, bad anatomy"
    },
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    },
    "_meta": { "title": "Character Reference Image" }
  },
  "5": {
    "class_type": "IPAdapterUnifiedLoaderFaceID",
    "inputs": {
      "model": ["1", 0],
      "preset": "FACEID",
      "lora_strength": 0.6,
      "provider": "CPU"
    },
    "_meta": { "title": "FaceID Loader" }
  },
  "6": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["5", 0],
      "ipadapter": ["5", 1],
      "image": ["4", 0],
      "weight": 0.85,
      "weight_faceidv2": 1.0,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "_meta": { "title": "Apply FaceID" }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": { "title": "Latent Image" }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0],
      "seed": 42,
      "steps": 6,
      "cfg": 2.0,
      "sampler_name": "dpmpp_sde",
      "scheduler": "karras",
      "denoise": 1.0
    },
    "_meta": { "title": "KSampler" }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "rpgspeak-faceid",
      "images": ["9", 0]
    },
    "_meta": { "title": "Save Image" }
  }
}
